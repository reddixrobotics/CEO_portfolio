# REDDIX ROBOTICS - ENVIRONMENT CONFIGURATION
# Admin Portal Password (default if unset: reddix@2026)
ADMIN_PASSWORD=reddix@2026

# Supabase Configuration (Free persistent PostgreSQL database & Storage)
# Get these in 30 seconds from your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Email Dispatch Configuration (Optional - for automated background delivery to reddixrobotics@gmail.com)
# Option A: Gmail SMTP with 16-character App Password (recommended for Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=reddixrobotics@gmail.com
SMTP_PASS=your-16-char-gmail-app-password

# Option B: Resend (Alternative high-speed transactional email service)
# RESEND_API_KEY=re_your_api_key_here

